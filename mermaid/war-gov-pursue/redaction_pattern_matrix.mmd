flowchart TB
    PURSUE["<b>PURSUE Release 01 — 161 records</b><br/>70 ⬛ REDACTED claims (4.6%)<br/>+ 24 🟧 ANALYTICAL FLAG (1.6%)"]

    subgraph PATTERN1["Pattern 1 — Witness identity (USPER) / Идентичность свидетеля"]
        P1_AFFECT["FBI 302s + DoW slide decks<br/>'USPER1..USPER7' convention<br/>FBI redaction prefix indicates<br/>federal employee status"]
        P1_REC["FBI-USPER-302<br/>FBI-ELLIPSE-Sr3/Sr4/Sr5<br/>DOW-WESTERN-US-2023 (7 USPER)"]
        P1_REC_R["<b>Recoverable:</b> No<br/>(intentional standing redaction)<br/><b>Восстанавливается:</b> нет"]
    end

    subgraph PATTERN2["Pattern 2 — Page 1 missing (Sr4 + Sr5) / Страница 1 отсутствует"]
        P2_AFFECT["FBI-ELLIPSE only<br/>Systematic, not random<br/>Page 1 of 2 withheld for both<br/>corroborating witnesses"]
        P2_REC["FBI-ELLIPSE-Sr4 (page 2 only)<br/>FBI-ELLIPSE-Sr5 (page 2 only)<br/>Sr3 = full 2 of 2 released"]
        P2_REC_R["<b>Recoverable:</b> Future tranche / FOIA<br/>Possibly contains:<br/>'materialized from bright light'<br/>entry phenomenology"]
    end

    subgraph PATTERN3["Pattern 3 — Location coordinates / Координаты местоположения"]
        P3_AFFECT["DoW MISREP D-series<br/>Structured lat/long fields redacted;<br/>only broad AOR envelope preserved<br/>Some basing in narrative survives"]
        P3_REC["DOW-D3..D75 (modern military)<br/>CENTCOM AOR retained;<br/>specific basing OMAM, OJMS, LGLR<br/>only narratively"]
        P3_REC_R["<b>Recoverable:</b> No<br/>(operational-security standing redaction)"]
    end

    subgraph PATTERN4["Pattern 4 — AARO metadata mislabel / Несогласованность AARO"]
        P4_AFFECT["AARO portal-side metadata<br/>cataloging defect — content does NOT<br/>match the labeled MISREP companion<br/>Tagged 🟧 ANALYTICAL FLAG"]
        P4_REC["DOW-PR28 labeled D7, matches D25<br/>DOW-PR29 labeled D8, matches D27<br/>(documented portal cataloging defect)"]
        P4_REC_R["<b>Recoverable:</b> Trivially<br/>(metadata-vs-content reconciliation;<br/>portal lacks reconciliation gate)"]
    end

    subgraph PATTERN5["Pattern 5 — Sensor data not provided / Сенсорные данные не предоставлены"]
        P5_AFFECT["MISREP boilerplate:<br/>'sensor data not provided'<br/>'imagery not provided'<br/>structured field populated<br/>but no attachment delivered"]
        P5_REC["Most D-series MISREPs<br/>FBI-ELLIPSE site sensors<br/>(range cameras, radar, RF, IR, LiDAR)<br/>— all silent in release"]
        P5_REC_R["<b>Recoverable:</b> Unknown<br/>(unclear if data exists or was<br/>never collected)"]
    end

    subgraph PATTERN6["Pattern 6 — Missing PDFs (DOS cluster) / Пропущенные PDF (DOS)"]
        P6_AFFECT["57% missing-PDF rate in DOS cluster<br/>(4 of 7 cables)<br/>Mechanism: download script failed<br/>on shared-prefix slug collisions"]
        P6_REC["DOS-1952-MEMO (slug collision)<br/>DOS-TBI-2001 (timeout?)<br/>DOS-MEX-2003 (timeout?)<br/>DOS-TKM-2004 (timeout?)"]
        P6_REC_R["<b>Recoverable:</b> Yes<br/>(re-download paths in<br/>catalog/irrelevant_sources.md §7)"]
    end

    subgraph PATTERN7["Pattern 7 — Corrupted PDF / Повреждённый PDF"]
