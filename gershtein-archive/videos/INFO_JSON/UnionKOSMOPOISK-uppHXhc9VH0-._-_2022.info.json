ческих существ, преимущественно схожих с описанием \"снежного человека\", и их пересечениях. Материал, который приводится в докладе, описывает события происходящие в США в 70-е годы.", "channel_id": "UCIuWiaC4krtcXM9kedaNFnA", "channel_url": "https://www.youtube.com/channel/UCIuWiaC4krtcXM9kedaNFnA", "duration": 7131, "view_count": 21254, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=uppHXhc9VH0", "categories": ["Science & Technology"], "tags": ["Космопоиск", "криптофизика", "уфология", "непознанное", "аномалистика", "криптозоология", "криптобиология", "Йети", "Снежный человек", "уфолог", "Герштейн", "Михаил Герштейн", "НЛО", "UFO"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 103, "location": "SAINT PETERSBURG", "like_count": 648, "channel": "UnionKOSMOPOISK", "channel_follower_count": 61900, "uploader": "UnionKOSMOPOISK", "uploader_id": "@UnionKOSMOPOISK", "uploader_url": "https://www.youtube.com/@UnionKOSMOPOISK", "upload_date": "20221011", "timestamp": 1665532329, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "display_id": "uppHXhc9VH0", "fulltitle": "Михаил Герштейн. Уфология и криптозоология: неожиданные взаимосвязи (2022)", "duration_string": "1:58:51", "is_live": false, "was_live": false, "epoch": 1778145871, "format": "136 - 1280x720 (720p)+251 - audio only (medium)", "format_id": "136+251", "ext": "mp4", "protocol": "https+https", "format_note": "720p+medium", "filesize_approx": 759105977, "tbr": 851.611, "width": 1280, "height": 720, "resolution": "1280x720", "fps": 25, "dynamic_range": "SDR", "vcodec": "avc1.4d401f", "vbr": 738.021, "aspect_ratio": 1.78, "acodec": "opus", "abr": 113.59, "asr": 48000, "audio_channels": 2, "_type"